\contentsline {section}{\numberline {7}评价与讨论}{22}{section.7}%
\contentsline {subsection}{\numberline {7.1}论文的非凡之处}{22}{subsection.7.1}%
\contentsline {paragraph}{1. 问对了问题，并且答得干净利落。}{22}{paragraph*.43}%
\contentsline {paragraph}{2. 方法论上的真正创新：给数据流下界装上了“信息论 + 几何”的引擎。}{22}{paragraph*.44}%
\contentsline {paragraph}{3. 一个副产品比主定理还要长寿：Gap-Hamming 问题。}{22}{paragraph*.45}%
\contentsline {paragraph}{4. 工具皆为成熟成品，组合方式却出人意料。}{22}{paragraph*.46}%
\contentsline {subsection}{\numberline {7.2}局限与批评}{22}{subsection.7.2}%
\contentsline {paragraph}{1. 参数范围不够紧致，留下了 $m^{-1/9}$ 与 $m^{-1/2}$ 之间的 gap。}{22}{paragraph*.47}%
\contentsline {paragraph}{2. 模型覆盖面窄。}{23}{paragraph*.48}%
\contentsline {paragraph}{3. 行文密度过高，存在若干伤读者的小瑕疵。}{23}{paragraph*.49}%
\contentsline {paragraph}{4. 结构性直觉着墨不足。}{23}{paragraph*.50}%
\contentsline {subsection}{\numberline {7.3}对后续研究的影响}{23}{subsection.7.3}%
\contentsline {paragraph}{下界侧：Gap-Hamming 谱系与“全参数最优”的收尾。}{23}{paragraph*.51}%
\contentsline {paragraph}{上界侧：刺激最优算法的诞生。}{23}{paragraph*.52}%
\contentsline {paragraph}{范式侧：通信复杂性驱动的流式下界方法论。}{23}{paragraph*.53}%
\contentsline {paragraph}{实践侧：为工程界的对数级空间正名。}{24}{paragraph*.54}%
